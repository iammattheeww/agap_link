* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.header h1 {
    font-size: 24px;
}

.add-btn {
    background: #ff6a00;
    color: #fff;
    padding: 10px 16px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

/* CARD */
.card {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

/* SEARCH */
.search-box {
    margin-bottom: 20px;
}

.search-box input {
    width: 300px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 8px;
}

/* TABLE */
table {
    width: 100%;
    border-collapse: collapse;
}

thead {
    text-align: left;
    font-size: 14px;
    color: #64748b;
}

th, td {
    padding: 12px 10px;
    border-bottom: 1px solid #eee;
}

.user-name {
    font-weight: 600;
}

.user-email {
    font-size: 13px;
    color: #64748b;
}

/* BADGES */
.badge {
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
}

.role {
    background: #e2e8f0;
}

.active {
    background: #16a34a;
    color: #fff;
}

.inactive {
    background: #e5e7eb;
    color: #555;
}

/* ACTIONS */
.actions a {
    margin-right: 10px;
    text-decoration: none;
    color: #555;
}

/* ============================= */
/* USERS MANAGEMENT PAGE STYLES */
/* ============================= */

.users-section {
  background: var(--color-white);
  padding: 30px;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.users-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
}

.users-title {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--color-secondary);
  font-family: var(--font-display);
}

.btn-add-user {
  background-color: var(--color-primary);
  color: var(--color-white);
  border: none;
  padding: 10px 20px;
  border-radius: var(--radius-md);
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.btn-add-user:hover {
  background-color: var(--color-primary-dark);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

/* SEARCH BAR */
.users-search {
  margin-bottom: 20px;
}

.users-search input {
  width: 100%;
  max-width: 400px;
  padding: 12px 16px;
  border: 2px solid var(--color-gray-300);
  border-radius: var(--radius-md);
  font-size: 0.95rem;
  transition: var(--transition-fast);
}

.users-search input:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
}

/* USERS TABLE */
.users-table {
  width: 100%;
  border-collapse: collapse;
}

.users-table thead {
  text-align: left;
  font-size: 0.85rem;
  color: var(--color-gray-600);
}

.users-table th {
  padding: 12px 10px;
  font-weight: 600;
}

.users-table td {
  padding: 15px 10px;
  border-top: 1px solid var(--color-gray-200);
  vertical-align: middle;
}

.users-table tr:hover {
  background-color: var(--color-gray-100);
}

/* USER INFO */
.user-info {
  display: flex;
  flex-direction: column;
}

.user-fullname {
  font-weight: 600;
  color: var(--color-secondary);
}

.user-email {
  font-size: 0.85rem;
  color: var(--color-gray-600);
}

/* ROLE BADGE */
.role-badge {
  padding: 5px 14px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  background-color: var(--color-gray-100);
  color: var(--color-gray-800);
}

/* STATUS BADGES */
.status-active {
  background-color: #d1fae5;
  color: #065f46;
  padding: 5px 14px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
}

.status-inactive {
  background-color: #fee2e2;
  color: #991b1b;
  padding: 5px 14px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
}

/* ACTION BUTTONS */
.user-actions {
  display: flex;
  gap: 8px;
}

.user-actions a {
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
  text-decoration: none;
  font-weight: 600;
  transition: var(--transition-fast);
}

.action-edit {
  background-color: #dbeafe;
  color: #1e40af;
}

.action-edit:hover {
  background-color: #bfdbfe;
}

.action-delete {
  background-color: #fee2e2;
  color: #991b1b;
}

.action-delete:hover {
  background-color: #fecaca;
}
